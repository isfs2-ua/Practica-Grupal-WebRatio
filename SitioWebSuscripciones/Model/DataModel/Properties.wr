    <Attribute name="email" id="email" type="string" db:column="email"/>
    <Attribute id="User#att20" name="totalGasto" type="decimal" derivationQuery="calculated::sum(Self.rel5#role10(as Var1).rel4#role7(as Var2).ent3#att11)" db:table="user_totalgasto_view" db:column="der_attr" storageType="file">
      <db:JoinColumn attribute="userOID" name="id"/>
    </Attribute>
  </Entity>
