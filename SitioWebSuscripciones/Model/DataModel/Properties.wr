<DataModel xmlns:db="http://www.webratio.com/2006/WebML/Database" xmlns:gr="http://www.webratio.com/2006/WebML/Graph">
  <Entity id="User" name="User" duration="persistent" gr:x="255" gr:y="130" gr:hideAttributes="false" attributeOrder="userOID userName password email User#att20" db:database="db1" db:table="user">
